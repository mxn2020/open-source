{
  "name": "api-rate-limit-visualizer",
  "version": "0.1.0",
  "description": "A web dashboard that visualizes API rate limit usage and patterns with real-time charts.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "test": "vitest run",
    "format": "prettier --check src/"
  },
  "keywords": [
    "api",
    "rate-limit",
    "dashboard",
    "visualizer",
    "recharts",
    "react",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.3"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^6.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "vitest": "^3.2.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^26.1.0",
    "eslint": "^9.27.0",
    "prettier": "^3.5.3",
    "@typescript-eslint/parser": "^8.33.0",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5"
  }
}
